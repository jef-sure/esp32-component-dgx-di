# DGX-DI's words for a program's CMakeLists: ESP-IDF includes this file of every component before any CMakeLists.
#
#     dgx_di_keyboard_font(<need> <layout.json> [FILE <font.c>])
#
# The font of a keyboard layout's labels, asked of DGX's font needs (dgx_font_need, DGX 0.7.2 and later): the face and
# the size the keyboard editor saved in the layout's "font" (a face by its PostScript name and millimetres, or a font of
# DGX by its name), with the letters the labels show; FILE: a font of the program's own instead, its letters checked.
# The program gives the keyboard dgx_font_<need>() of dgx_fonts.h. Paths are from the CMakeLists it is written in; an
# edited layout configures the project again.

# the letters a layout's labels show, as the keyboard draws them (keyboard_blob.py letters(), the editor's): a key's own
# label, else its character and its character with shift; a key that edits has none
function(_dgx_di_keyboard_letters json out)
    set(letters "")
    string(JSON pages ERROR_VARIABLE error LENGTH "${json}" pages)
    if(error OR pages EQUAL 0)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    math(EXPR last_page "${pages} - 1")
    foreach(p RANGE ${last_page})
        string(JSON rows ERROR_VARIABLE error LENGTH "${json}" pages ${p} rows)
        if(error OR rows EQUAL 0)
            continue()
        endif()
        math(EXPR last_row "${rows} - 1")
        foreach(r RANGE ${last_row})
            string(JSON keys ERROR_VARIABLE error LENGTH "${json}" pages ${p} rows ${r})
            if(error OR keys EQUAL 0)
                continue()
            endif()
            math(EXPR last_key "${keys} - 1")
            foreach(k RANGE ${last_key})
                string(JSON label ERROR_VARIABLE error GET "${json}" pages ${p} rows ${r} ${k} label)
                if(NOT error AND NOT "${label}" STREQUAL "")
                    string(APPEND letters "${label}\n")
                    continue()
                endif()
                string(JSON char ERROR_VARIABLE error GET "${json}" pages ${p} rows ${r} ${k} char)
                if(NOT error)
                    string(APPEND letters "${char}")
                    string(JSON upper ERROR_VARIABLE error GET "${json}" pages ${p} rows ${r} ${k} upper)
                    if(NOT error)
                        string(APPEND letters "${upper}")
                    endif()
                    string(APPEND letters "\n")
                endif()
            endforeach()
        endforeach()
    endforeach()
    set(${out} "${letters}" PARENT_SCOPE)
endfunction()

function(dgx_di_keyboard_font need layout)
    if(CMAKE_BUILD_EARLY_EXPANSION)
        return()
    endif()
    cmake_parse_arguments(K "" "FILE" "" ${ARGN})
    if(NOT COMMAND dgx_font_need)
        message(FATAL_ERROR "dgx_di_keyboard_font(${need}): DGX has no font needs (dgx_font_need): DGX 0.7.2 or later")
    endif()
    get_filename_component(path "${layout}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "dgx_di_keyboard_font(${need}): no layout ${path}")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE) # (its tests run it as a script)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endif()
    file(READ "${path}" json)
    string(JSON format ERROR_VARIABLE error GET "${json}" format)
    if(error OR NOT "${format}" STREQUAL "dgx-di-keyboard")
        message(FATAL_ERROR "dgx_di_keyboard_font(${need}): ${path} is not a keyboard layout of DGX-DI")
    endif()
    # its letters in a file of the build, written only when they change: else DGX's font rule runs at every configuration
    _dgx_di_keyboard_letters("${json}" letters)
    set(file "${CMAKE_BINARY_DIR}/dgx_di/${need}.letters")
    set(was "")
    if(EXISTS "${file}")
        file(READ "${file}" was)
    endif()
    if(NOT "${was}" STREQUAL "${letters}")
        file(WRITE "${file}" "${letters}")
    endif()
    if(K_FILE)
        dgx_font_need(${need} FILE "${K_FILE}" TEXTS "${file}")
        return()
    endif()
    string(JSON font ERROR_VARIABLE error GET "${json}" font)
    if(error)
        message(FATAL_ERROR "dgx_di_keyboard_font(${need}): ${path} names no font of its labels: choose one in the keyboard editor of DGX-DI")
    endif()
    string(JSON dgx ERROR_VARIABLE error GET "${json}" font dgx)
    if(NOT error AND NOT "${dgx}" STREQUAL "")
        dgx_font_need(${need} DGX ${dgx} TEXTS "${file}")
        return()
    endif()
    string(JSON postscript ERROR_VARIABLE error GET "${json}" font postscript)
    if(error OR "${postscript}" STREQUAL "")
        message(FATAL_ERROR "dgx_di_keyboard_font(${need}): the font of ${path} has no PostScript name: choose it again in the keyboard editor")
    endif()
    string(JSON mm ERROR_VARIABLE error GET "${json}" font mm)
    if(NOT error)
        set(size "${mm}mm")
    else()
        string(JSON px ERROR_VARIABLE error GET "${json}" font px)
        if(error)
            message(FATAL_ERROR "dgx_di_keyboard_font(${need}): the font of ${path} has no size: set it in the keyboard editor")
        endif()
        set(size "${px}px")
    endif()
    dgx_font_need(${need} SIZE ${size} POSTSCRIPT ${postscript} TEXTS "${file}")
endfunction()
